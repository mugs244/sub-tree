datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                Int             @id @default(autoincrement())
  clerk_user_id     String          @unique
  username          String?         @unique
  phone             String?
  momo_number       String?
  email             String?
  email_verified_at DateTime?
  account_type      AccountType     @default(INDIVIDUAL)
  tier              Tier            @default(FREE)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  deleted_at        DateTime?

  username_claims    UsernameClaim[]
  profile            Profile?
  links              Link[]
  donations          Donation[]
  subscription       Subscription?
  fundraisers        Fundraiser[]    @relation("user_fundraisers")
  charity_campaigns  Fundraiser[]    @relation("charity_fundraisers")

  @@index([clerk_user_id])
}

model Profile {
  id            Int     @id @default(autoincrement())
  user_id       Int     @unique
  display_name  String
  bio           String?
  avatar_url    String?
  theme_preset  String  @default("default")
  button_style  String  @default("rounded")
  view_count    Int     @default(0)

  // Pro custom theme (nullable — falls back to preset)
  theme_bg_color     String?
  theme_accent_color String?
  theme_button_color String?
  theme_button_text  String?
  theme_card_bg      String?
  theme_card_text    String?
  theme_font         String?
  hide_branding      Boolean @default(false)

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user          User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model Link {
  id                   Int       @id @default(autoincrement())
  user_id              Int
  url                  String
  label                String
  is_enabled           Boolean   @default(true)
  position             Int       @default(0)
  clicks               Int       @default(0)
  link_type            LinkType  @default(URL)
  smart_card_meta      Json?
  smart_card_fetched_at DateTime?
  render_as_plain      Boolean   @default(false)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  user                 User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([user_id, is_enabled])
}

enum LinkType {
  URL
  SMART_CARD
  AFFILIATE
  FUNDRAISER
}

model ReservedUsername {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  reason     String?
  created_at DateTime @default(now())

  @@index([username])
}

model UsernameClaim {
  id          Int         @id @default(autoincrement())
  user_id     Int
  username    String
  status      ClaimStatus @default(PENDING)
  message     String?
  reviewed_at DateTime?
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([username])
  @@index([status])
}

model Subscription {
  id                  Int                @id @default(autoincrement())
  user_id             Int                @unique
  tier                Tier
  status              SubscriptionStatus @default(TRIALING)
  trial_ends_at       DateTime?
  current_period_end  DateTime
  idempotency_key     String             @unique
  provider_ref        String?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  user                User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  events              SubscriptionEvent[]

  @@index([status])
  @@index([current_period_end])
  @@index([trial_ends_at])
}

model SubscriptionEvent {
  id              Int          @id @default(autoincrement())
  subscription_id Int
  event_type      String
  payload         Json
  created_at      DateTime     @default(now())

  subscription    Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@index([subscription_id])
}

model ContentHouseRequest {
  id                  Int                       @id @default(autoincrement())
  status              ContentHouseRequestStatus @default(PENDING)
  company_email       String
  social_platforms    String[]
  features_requested  String[]
  notes               String?
  reviewed_by         String?
  reviewed_at         DateTime?
  created_at          DateTime                  @default(now())
  updated_at          DateTime                  @updatedAt

  members             ContentHouseMember[]

  @@index([status])
  @@index([created_at])
}

model ContentHouseMember {
  id          Int                 @id @default(autoincrement())
  request_id  Int
  name        String
  phone       String
  email       String
  share_rate  Decimal             @db.Decimal(5, 2)

  request     ContentHouseRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)

  @@index([request_id])
}

enum AccountType {
  INDIVIDUAL
  BUSINESS
  NGO
}

enum Tier {
  FREE
  PRO
  BUSINESS
  CONTENT_HOUSE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum ContentHouseRequestStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

model Donation {
  id              Int            @id @default(autoincrement())
  user_id         Int
  donor_phone     String
  donor_name      String?
  amount          Int
  currency        String         @default("UGX")
  status          DonationStatus @default(PENDING)
  provider        MomoProvider
  provider_tx_id  String?        @unique
  idempotency_key String         @unique
  note             String?
  referrer_source  String?
  fundraiser_id    Int?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  user            User           @relation(fields: [user_id], references: [id], onDelete: Restrict)
  fundraiser      Fundraiser?    @relation(fields: [fundraiser_id], references: [id], onDelete: SetNull)
  events          DonationEvent[]

  @@index([user_id])
  @@index([status])
  @@index([user_id, status])
  @@index([fundraiser_id])
}

model Fundraiser {
  id              Int               @id @default(autoincrement())
  user_id         Int
  fundraiser_type FundraiserType    @default(PERSONAL)
  title           String
  description     String            @db.Text
  goal_amount     BigInt
  raised_amount   BigInt            @default(0)
  deadline        DateTime?
  cover_image_url String?
  show_progress   Boolean           @default(true)
  status          FundraiserStatus  @default(DRAFT)

  charity_user_id           Int?
  charity_approval_status   CharityApprovalStatus?
  charity_split_creator_pct Int?
  charity_split_charity_pct Int?
  charity_approved_at       DateTime?
  charity_rejected_at       DateTime?
  charity_rejection_reason  String?

  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt

  user            User              @relation("user_fundraisers", fields: [user_id], references: [id], onDelete: Cascade)
  charity_user    User?             @relation("charity_fundraisers", fields: [charity_user_id], references: [id])
  donations       Donation[]

  @@index([user_id])
  @@index([charity_user_id])
  @@index([status])
}

enum FundraiserType {
  PERSONAL
  CHARITY
}

enum FundraiserStatus {
  DRAFT
  ACTIVE
  CLOSED
  COMPLETED
  EXPIRED
}

enum CharityApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model DonationEvent {
  id          Int       @id @default(autoincrement())
  donation_id Int
  event_type  String
  payload     Json
  read_at     DateTime?
  created_at  DateTime  @default(now())

  donation    Donation  @relation(fields: [donation_id], references: [id], onDelete: Restrict)

  @@index([donation_id])
  @@index([donation_id, read_at])
}

enum DonationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum MomoProvider {
  MTN_MOMO
  AIRTEL_MONEY
}
