datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                Int             @id @default(autoincrement())
  clerk_user_id     String          @unique
  username          String?         @unique
  phone             String?
  email             String?
  email_verified_at DateTime?
  account_type      AccountType     @default(INDIVIDUAL)
  tier              Tier            @default(FREE)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  deleted_at        DateTime?

  username_claims   UsernameClaim[]
  profile           Profile?
  links             Link[]

  @@index([clerk_user_id])
}

model Profile {
  id         Int     @id @default(autoincrement())
  user_id    Int     @unique
  display_name String
  bio        String?
  avatar_url String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user       User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model Link {
  id         Int     @id @default(autoincrement())
  user_id    Int
  url        String
  label      String
  is_enabled Boolean @default(true)
  position   Int     @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user       User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([user_id, is_enabled])
}

model ReservedUsername {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  reason     String?
  created_at DateTime @default(now())

  @@index([username])
}

model UsernameClaim {
  id          Int         @id @default(autoincrement())
  user_id     Int
  username    String
  status      ClaimStatus @default(PENDING)
  message     String?
  reviewed_at DateTime?
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([username])
  @@index([status])
}

enum AccountType {
  INDIVIDUAL
  BUSINESS
  NGO
}

enum Tier {
  FREE
  PRO
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}
