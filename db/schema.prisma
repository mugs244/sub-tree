datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                Int             @id @default(autoincrement())
  clerk_user_id     String          @unique
  username          String?         @unique
  phone             String?
  momo_number       String?
  email             String?
  email_verified_at DateTime?
  account_type      AccountType     @default(INDIVIDUAL)
  tier              Tier            @default(FREE)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  deleted_at        DateTime?

  username_claims   UsernameClaim[]
  profile           Profile?
  links             Link[]
  donations         Donation[]

  @@index([clerk_user_id])
}

model Profile {
  id            Int     @id @default(autoincrement())
  user_id       Int     @unique
  display_name  String
  bio           String?
  avatar_url    String?
  theme_preset  String  @default("default")
  button_style  String  @default("rounded")
  view_count    Int     @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user          User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model Link {
  id         Int     @id @default(autoincrement())
  user_id    Int
  url        String
  label      String
  is_enabled Boolean @default(true)
  position   Int     @default(0)
  clicks     Int     @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user       User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([user_id, is_enabled])
}

model ReservedUsername {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  reason     String?
  created_at DateTime @default(now())

  @@index([username])
}

model UsernameClaim {
  id          Int         @id @default(autoincrement())
  user_id     Int
  username    String
  status      ClaimStatus @default(PENDING)
  message     String?
  reviewed_at DateTime?
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([username])
  @@index([status])
}

enum AccountType {
  INDIVIDUAL
  BUSINESS
  NGO
}

enum Tier {
  FREE
  PRO
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

model Donation {
  id              Int            @id @default(autoincrement())
  user_id         Int
  donor_phone     String
  donor_name      String?
  amount          Int
  currency        String         @default("UGX")
  status          DonationStatus @default(PENDING)
  provider        MomoProvider
  provider_tx_id  String?        @unique
  idempotency_key String         @unique
  note             String?
  referrer_source  String?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  user            User           @relation(fields: [user_id], references: [id], onDelete: Restrict)
  events          DonationEvent[]

  @@index([user_id])
  @@index([status])
  @@index([user_id, status])
}

model DonationEvent {
  id          Int       @id @default(autoincrement())
  donation_id Int
  event_type  String
  payload     Json
  read_at     DateTime?
  created_at  DateTime  @default(now())

  donation    Donation  @relation(fields: [donation_id], references: [id], onDelete: Restrict)

  @@index([donation_id])
  @@index([donation_id, read_at])
}

enum DonationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum MomoProvider {
  MTN_MOMO
  AIRTEL_MONEY
}
