datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                Int             @id @default(autoincrement())
  clerk_user_id     String          @unique
  username          String?         @unique
  phone             String?
  momo_number       String?
  email             String?
  email_verified_at DateTime?
  account_type      AccountType     @default(INDIVIDUAL)
  tier              Tier            @default(FREE)
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  deleted_at        DateTime?

  username_claims    UsernameClaim[]
  profile            Profile?
  links              Link[]
  donations          Donation[]
  subscription       Subscription?
  fundraisers        Fundraiser[]    @relation("user_fundraisers")
  charity_campaigns  Fundraiser[]    @relation("charity_fundraisers")
  products           Product[]       @relation("seller_products")
  seller_orders      Order[]         @relation("seller_orders")
  affiliate_orders   Order[]         @relation("affiliate_orders")
  shop_affiliates    AffiliateRelationship[] @relation("shop_affiliates")
  my_affiliates      AffiliateRelationship[] @relation("my_affiliates")
  affiliate_payouts  AffiliatePayoutRecord[]

  @@index([clerk_user_id])
}

model Profile {
  id            Int     @id @default(autoincrement())
  user_id       Int     @unique
  display_name  String
  bio           String?
  avatar_url    String?
  theme_preset  String  @default("default")
  button_style  String  @default("rounded")
  view_count    Int     @default(0)

  // Pro custom theme (nullable — falls back to preset)
  theme_bg_color     String?
  theme_accent_color String?
  theme_button_color String?
  theme_button_text  String?
  theme_card_bg      String?
  theme_card_text    String?
  theme_font         String?
  hide_branding      Boolean @default(false)

  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user          User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model Link {
  id                   Int       @id @default(autoincrement())
  user_id              Int
  url                  String
  label                String
  is_enabled           Boolean   @default(true)
  position             Int       @default(0)
  clicks               Int       @default(0)
  link_type            LinkType  @default(URL)
  smart_card_meta      Json?
  smart_card_fetched_at DateTime?
  render_as_plain      Boolean   @default(false)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  user                 User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([user_id, is_enabled])
}

enum LinkType {
  URL
  SMART_CARD
  AFFILIATE
  FUNDRAISER
}

model ReservedUsername {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  reason     String?
  created_at DateTime @default(now())

  @@index([username])
}

model UsernameClaim {
  id          Int         @id @default(autoincrement())
  user_id     Int
  username    String
  status      ClaimStatus @default(PENDING)
  message     String?
  reviewed_at DateTime?
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([username])
  @@index([status])
}

model Subscription {
  id                  Int                @id @default(autoincrement())
  user_id             Int                @unique
  tier                Tier
  status              SubscriptionStatus @default(TRIALING)
  trial_ends_at       DateTime?
  current_period_end  DateTime
  idempotency_key     String             @unique
  provider_ref        String?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  user                User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  events              SubscriptionEvent[]

  @@index([status])
  @@index([current_period_end])
  @@index([trial_ends_at])
}

model SubscriptionEvent {
  id              Int          @id @default(autoincrement())
  subscription_id Int
  event_type      String
  payload         Json
  created_at      DateTime     @default(now())

  subscription    Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@index([subscription_id])
}

model ContentHouseRequest {
  id                  Int                       @id @default(autoincrement())
  status              ContentHouseRequestStatus @default(PENDING)
  company_email       String
  social_platforms    String[]
  features_requested  String[]
  notes               String?
  reviewed_by         String?
  reviewed_at         DateTime?
  created_at          DateTime                  @default(now())
  updated_at          DateTime                  @updatedAt

  members             ContentHouseMember[]

  @@index([status])
  @@index([created_at])
}

model ContentHouseMember {
  id          Int                 @id @default(autoincrement())
  request_id  Int
  name        String
  phone       String
  email       String
  share_rate  Decimal             @db.Decimal(5, 2)

  request     ContentHouseRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)

  @@index([request_id])
}

enum AccountType {
  INDIVIDUAL
  BUSINESS
  NGO
}

enum Tier {
  FREE
  PRO
  BUSINESS
  CONTENT_HOUSE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum ContentHouseRequestStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

model Donation {
  id              Int            @id @default(autoincrement())
  user_id         Int
  donor_phone     String
  donor_name      String?
  amount          Int
  currency        String         @default("UGX")
  status          DonationStatus @default(PENDING)
  provider        MomoProvider
  provider_tx_id  String?        @unique
  idempotency_key String         @unique
  note             String?
  referrer_source  String?
  fundraiser_id    Int?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  user            User           @relation(fields: [user_id], references: [id], onDelete: Restrict)
  fundraiser      Fundraiser?    @relation(fields: [fundraiser_id], references: [id], onDelete: SetNull)
  events          DonationEvent[]

  @@index([user_id])
  @@index([status])
  @@index([user_id, status])
  @@index([fundraiser_id])
}

model Fundraiser {
  id              Int               @id @default(autoincrement())
  user_id         Int
  fundraiser_type FundraiserType    @default(PERSONAL)
  title           String
  description     String            @db.Text
  goal_amount     BigInt
  raised_amount   BigInt            @default(0)
  deadline        DateTime?
  cover_image_url String?
  show_progress   Boolean           @default(true)
  status          FundraiserStatus  @default(DRAFT)

  charity_user_id           Int?
  charity_approval_status   CharityApprovalStatus?
  charity_split_creator_pct Int?
  charity_split_charity_pct Int?
  charity_approved_at       DateTime?
  charity_rejected_at       DateTime?
  charity_rejection_reason  String?

  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt

  user            User              @relation("user_fundraisers", fields: [user_id], references: [id], onDelete: Cascade)
  charity_user    User?             @relation("charity_fundraisers", fields: [charity_user_id], references: [id])
  donations       Donation[]

  @@index([user_id])
  @@index([charity_user_id])
  @@index([status])
}

enum FundraiserType {
  PERSONAL
  CHARITY
}

enum FundraiserStatus {
  DRAFT
  ACTIVE
  CLOSED
  COMPLETED
  EXPIRED
}

enum CharityApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model ProductCategory {
  id         Int       @id @default(autoincrement())
  key        String    @unique
  label      String
  type       String    // "digital" | "physical" | "both"
  position   Int       @default(0)
  active     Boolean   @default(true)
  created_at DateTime  @default(now())

  products   Product[]
}

model Product {
  id                Int              @id @default(autoincrement())
  user_id           Int
  category_id       Int?
  name              String
  description       String           @db.Text
  price             BigInt
  product_type      ProductType
  cover_image_url   String?
  file_url          String?
  file_size_bytes   BigInt?
  shipping_info     String?
  stock             Int?
  auto_release_days Int              @default(7)
  affiliate_rate    Decimal          @default(0) @db.Decimal(5, 4)
  affiliate_open    Boolean          @default(false)
  status            ProductStatus    @default(ACTIVE)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt

  user              User             @relation("seller_products", fields: [user_id], references: [id], onDelete: Restrict)
  category          ProductCategory? @relation(fields: [category_id], references: [id])
  orders            Order[]
  affiliate_grants  AffiliateProductGrant[]

  @@index([user_id])
  @@index([status])
  @@index([category_id])
}

model Order {
  id                  Int             @id @default(autoincrement())
  product_id          Int
  seller_user_id      Int
  affiliate_user_id   Int?
  buyer_phone         String
  buyer_name          String
  buyer_email         String?
  amount_paid         BigInt
  platform_fee        BigInt
  seller_amount       BigInt
  affiliate_amount    BigInt?
  idempotency_key     String          @unique
  pesapal_txn_id      String?         @unique
  pesapal_provider    String
  payment_confirmed   Boolean         @default(false)
  escrow_status       EscrowStatus    @default(HELD)
  escrow_release_at   DateTime?
  dispute_raised_at   DateTime?
  released_at         DateTime?
  download_token      String?         @unique
  download_expires_at DateTime?
  download_count      Int             @default(0)
  affiliate_paid_at   DateTime?
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt

  product             Product         @relation(fields: [product_id], references: [id], onDelete: Restrict)
  seller              User            @relation("seller_orders", fields: [seller_user_id], references: [id], onDelete: Restrict)
  affiliate           User?           @relation("affiliate_orders", fields: [affiliate_user_id], references: [id], onDelete: SetNull)
  events              OrderEvent[]

  @@index([seller_user_id])
  @@index([affiliate_user_id])
  @@index([escrow_status])
  @@index([escrow_release_at])
  @@index([idempotency_key])
}

model OrderEvent {
  id          Int       @id @default(autoincrement())
  order_id    Int
  event_type  String
  actor_id    Int?
  metadata    Json?
  created_at  DateTime  @default(now())

  order       Order     @relation(fields: [order_id], references: [id], onDelete: Restrict)

  @@index([order_id])
}

enum ProductType {
  DIGITAL
  PHYSICAL
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  SOLD_OUT
}

enum EscrowStatus {
  HELD
  RELEASED
  DISPUTED
  REFUNDED
}

model AffiliateRelationship {
  id                Int                     @id @default(autoincrement())
  shop_user_id      Int
  affiliate_user_id Int
  initiated_by      AffiliateInitiator
  status            AffiliateStatus         @default(PENDING)
  requested_at      DateTime                @default(now())
  reviewed_at       DateTime?
  rejected_reason   String?
  created_at        DateTime                @default(now())

  shop_user         User                    @relation("shop_affiliates", fields: [shop_user_id], references: [id], onDelete: Restrict)
  affiliate_user    User                    @relation("my_affiliates", fields: [affiliate_user_id], references: [id], onDelete: Restrict)
  product_grants    AffiliateProductGrant[]

  @@unique([shop_user_id, affiliate_user_id])
  @@index([shop_user_id])
  @@index([affiliate_user_id])
  @@index([status])
}

model AffiliateProductGrant {
  id              Int       @id @default(autoincrement())
  relationship_id Int
  product_id      Int
  granted_at      DateTime  @default(now())
  revoked_at      DateTime?

  relationship    AffiliateRelationship @relation(fields: [relationship_id], references: [id], onDelete: Cascade)
  product         Product               @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@unique([relationship_id, product_id])
  @@index([relationship_id])
  @@index([product_id])
}

model AffiliatePayoutRecord {
  id                Int          @id @default(autoincrement())
  affiliate_user_id Int
  period_start      DateTime
  period_end        DateTime
  total_amount      BigInt
  order_count       Int
  pesapal_txn_id    String?      @unique
  status            PayoutStatus @default(PENDING)
  created_at        DateTime     @default(now())
  paid_at           DateTime?
  failure_reason    String?

  affiliate         User         @relation(fields: [affiliate_user_id], references: [id], onDelete: Restrict)

  @@index([affiliate_user_id])
  @@index([status])
}

enum AffiliateInitiator {
  CREATOR_REQUEST
  MERCHANT_INVITE
}

enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model DonationEvent {
  id          Int       @id @default(autoincrement())
  donation_id Int
  event_type  String
  payload     Json
  read_at     DateTime?
  created_at  DateTime  @default(now())

  donation    Donation  @relation(fields: [donation_id], references: [id], onDelete: Restrict)

  @@index([donation_id])
  @@index([donation_id, read_at])
}

enum DonationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum MomoProvider {
  MTN_MOMO
  AIRTEL_MONEY
}

model PlatformSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String   @default("")
  updated_by  Int?
  updated_at  DateTime @updatedAt
  created_at  DateTime @default(now())

  @@index([key])
}

model PlatformSettingAuditLog {
  id         Int      @id @default(autoincrement())
  key        String
  old_value  String
  new_value  String
  changed_by Int
  changed_at DateTime @default(now())

  @@index([key])
  @@index([changed_by])
}
